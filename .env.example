# Configuración de la aplicación ChatDoc

# Modo de IA: 'real' para usar Gemini, 'mock' para simulador
AI_MODE=mock

# API Key de Gemini (solo necesaria si AI_MODE=real)
# Obtén tu clave en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=tu-api-key-aqui

# Modelo de Gemini a usar
GEMINI_MODEL=gemini-1.5-flash

# Ruta de la base de datos SQLite
DB_PATH=chatdoc.db

# Preparado para MongoDB (futuro)
# MONGO_URI=mongodb://localhost:27017
# MONGO_DB=chatdoc
# MONGO_ENABLED=false
